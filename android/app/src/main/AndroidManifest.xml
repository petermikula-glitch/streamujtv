<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- zjištění, že se vrátilo připojení: stahování pak naváže samo -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- stahování na disk běží jako služba v popředí a nesmí ho přerušit uspání zařízení -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Záloha dat aplikace mimo složku aplikace (složka Promitarna v kořeni disku), aby přežila
         odinstalaci. Povolení dává uživatel sám v nastavení systému; bez něj se zálohuje do složky aplikace. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- aktualizace aplikace z GitHubu: předání nové verze systémovému instalátoru -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- rozkoukaná videa v řadě „Pokračovat ve sledování“ na domovské obrazovce Android TV -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- hledání hlasem v aplikaci (mikrofon v ovladači); bez mikrofonu se píše klávesnicí -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Oficiální aplikace iVysílání ČT: chráněné pořady se předávají jí (IVYS_APPS v app_api.py).
         Bez tohoto zápisu by ji systém aplikaci neukázal. -->
    <queries>
        <package android:name="cz.ceskatelevize.ivysilani.tvapp" />
        <package android:name="cz.motion.ivysilani" />
        <!-- upoutávky se otevírají v aplikaci YouTube -->
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube" />
        <!-- rozpoznávání řeči pro hledání hlasem (bez zápisu ho aplikace od Androidu 11 nevidí) -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- hledání systému a Asistenta Google uvnitř aplikace patří obrazovce Hledat -->
        <meta-data android:name="android.app.default_searchable" android:value=".SearchActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Browse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ListActivity" android:theme="@style/AppTheme.Grid" />
        <activity android:name=".PageActivity" />
        <activity android:name=".TitleActivity" />
        <!-- Hledat; přijímá i dotaz od Asistenta Google a systému (tlačítko mikrofonu si bere systém) -->
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.searchable" android:resource="@xml/searchable" />
        </activity>
        <activity android:name=".SettingsActivity" android:theme="@style/AppTheme.GuidedStep" />
        <activity android:name=".DiagnosticsActivity" />
        <!-- upoutávka ve vloženém přehrávači YouTube; po skončení se vrátí na stránku titulu -->
        <activity
            android:name=".TrailerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:hardwareAccelerated="true"
            android:theme="@style/PlayerTheme" />
        <activity android:name=".WelcomeActivity" android:theme="@style/AppTheme.GuidedStep" />
        <!-- vstup z domovské obrazovky televize: spustí rozkoukané video; nic jiného neumí -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mojevidea" android:host="play" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:theme="@style/PlayerTheme" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- drží aplikaci naživu, dokud se plní seznam dostupných titulů (i při spořiči obrazovky) -->
        <service
            android:name=".IndexService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
