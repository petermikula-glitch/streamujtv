<?xml version="1.0" encoding="utf-8"?>
<!-- Tlačítko na stránce titulu: vybrané je jantarové, ostatní tmavá s jemným obrysem. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="#CC18233B" />
            <stroke android:width="1dp" android:color="#663B4D75" />
        </shape>
    </item>
</selector>
