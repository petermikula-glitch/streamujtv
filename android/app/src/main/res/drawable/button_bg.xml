<?xml version="1.0" encoding="utf-8"?>
<!-- Tlačítko na stránce titulu: vybrané je rumělkové, ostatní papírová s jemným obrysem. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="#B3E3DBC8" />
            <stroke android:width="1dp" android:color="#665F5A50" />
        </shape>
    </item>
</selector>
