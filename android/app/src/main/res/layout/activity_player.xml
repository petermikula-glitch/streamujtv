<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:buffered_color="#66FFFFFF"
        app:played_color="@color/accent"
        app:scrubber_color="@color/accent"
        app:show_buffering="when_playing"
        app:show_subtitle_button="true"
        app:unplayed_color="#33FFFFFF" />

    <!-- horní lišta: název videa, čas konce a rychlé volby; ukazuje se spolu s ovládáním -->
    <LinearLayout
        android:id="@+id/player_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_title_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/player_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/player_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/player_text_secondary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/player_audio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_button_bg"
            android:contentDescription="Zvuková stopa"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_audio" />

        <ImageButton
            android:id="@+id/player_subtitles"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_button_bg"
            android:contentDescription="Titulky"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_subtitles" />

        <ImageButton
            android:id="@+id/player_restart"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_button_bg"
            android:contentDescription="Přehrát od začátku"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_restart" />
    </LinearLayout>

    <!-- po dokoukání: nabídka dalšího dílu seriálu nebo dalšího filmu série -->
    <LinearLayout
        android:id="@+id/next_panel"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/next_panel_bg"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/player_text"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/next_play"
                style="@style/TitleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:nextFocusRight="@+id/next_close" />

            <Button
                android:id="@+id/next_close"
                style="@style/TitleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:nextFocusLeft="@id/next_play"
                android:text="Zavřít" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/player_spinner"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/player_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="640dp"
            android:textColor="@color/player_text"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
